#!/usr/bin/env bash
# Pre-commit secret scan. Wired via `git config core.hooksPath .githooks`,
# which `pnpm install` sets up automatically (root "prepare" script).
set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed — refusing to commit unscanned changes." >&2
  echo "  install: brew install gitleaks   (or see https://github.com/gitleaks/gitleaks#installing)" >&2
  exit 1
fi

# Lint and format staged files first (fixes are re-staged automatically),
# then scan the final staged content for secrets.
pnpm exec lint-staged

exec gitleaks git --pre-commit --staged --redact --verbose
