{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "rootDirs": [".", "./.react-router/types"],
    "outDir": "dist",
    "jsx": "react-jsx",
    "lib": ["esnext", "dom", "dom.iterable"],
    "types": ["@cloudflare/workers-types/experimental", "vite/client"],
    "paths": {
      "~/*": ["./app/*"]
    }
  },
  "include": ["app", "server", "*.ts", "*.tsx", "env.d.ts", ".react-router/types/**/*.ts"]
}
