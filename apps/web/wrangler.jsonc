{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "starter-web",
  "compatibility_date": "2026-03-31",
  "compatibility_flags": ["nodejs_compat"],
  "main": "build/server/index.js",
  "assets": {
    "directory": "build/client"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "starter-db",
      "database_id": "local",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "vars": {
    "BETTER_AUTH_SECRET": "dev-secret-must-be-at-least-32-characters-long",
    "BETTER_AUTH_URL": "http://localhost:5173",
    "ENVIRONMENT": "development",
    // Social login — set these to enable GitHub/Google OAuth
    // Get GitHub credentials at: https://github.com/settings/developers
    // Get Google credentials at: https://console.cloud.google.com/apis/credentials
    "GITHUB_CLIENT_ID": "",
    "GITHUB_CLIENT_SECRET": "",
    "GOOGLE_CLIENT_ID": "",
    "GOOGLE_CLIENT_SECRET": ""
  }
}
