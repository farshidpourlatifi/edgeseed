{
  "name": "cloudflare-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "build": "turbo build",
    "dev": "turbo dev",
    "typecheck": "turbo typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "tsx packages/cli/src/db-generate.ts",
    "db:migrate": "tsx packages/cli/src/db-migrate.ts",
    "db:seed": "tsx packages/cli/src/db-seed.ts",
    "db:reset": "tsx packages/cli/src/db-reset.ts",
    "api:spec": "tsx packages/cli/src/api-spec.ts",
    "init:product": "tsx packages/cli/src/init-product.ts",
    "check:docs-sync": "tsx packages/cli/src/check-docs-sync.ts",
    "version:bump": "tsx packages/cli/src/version-bump.ts",
    "verify": "pnpm lint && pnpm format:check && pnpm test && gitleaks git --redact && pnpm build && pnpm typecheck && pnpm test:e2e",
    "deploy:web": "pnpm verify && pnpm --filter @starter/web exec wrangler deploy"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,jsonc,md,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^22",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "lint-staged": "^17.3.0",
    "prettier": "^3",
    "tsx": "^4",
    "turbo": "^2",
    "typescript": "^5.7",
    "typescript-eslint": "^8.66.0",
    "vitest": "^3"
  },
  "packageManager": "pnpm@9.15.4",
  "dependencies": {
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.473",
    "radix-ui": "^1.4.3",
    "react-day-picker": "^9.14.0",
    "react-resizable-panels": "^4.8.0",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  }
}
